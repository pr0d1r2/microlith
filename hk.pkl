/// microlith's gate, defined ONCE (V22).
///
/// Every op below is a plain cargo command a human can paste into a shell.
/// hk decides *when* they run; it never hides *what* runs, so a verdict
/// never rests on the runner's own logic (V22).
///
/// The schema is VENDORED at `pkl/Config.pkl` rather than fetched from a
/// `package://` URL at eval time: offline-first is the default build, not
/// merely the default flag.
amends "pkl/Config.pkl"

/// Success is silence. Output that always appears is output nobody reads,
/// which is how a real failure hides in noise everyone learned to scroll
/// past. Failure is loud and carries its own remediation.
///
/// `fail_fast` locally because the loop is cheap, so the FIRST failure is
/// the most useful thing to surface, and `depends` orders steps
/// cheapest-first so it arrives fast. CI inverts this (`--no-fail-fast`):
/// there a round-trip costs minutes, so a complete list beats an early one.
fail_fast = true

env {
  ["HK_HIDE_WHEN_DONE"] = "true"
}

/// `depends` chains the cargo steps deliberately. Cargo takes a lock on the
/// target directory, so two cargo jobs launched in parallel do not run in
/// parallel -- the second blocks on "Blocking waiting for file lock on
/// build directory", which READS AS A HANG. Chaining makes the
/// serialization explicit and leaves hk free to run the non-cargo checks
/// concurrently.
local fast = new Mapping<String, Step> {
  ["fmt"] {
    glob = List("**/*.rs")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  ["clippy"] {
    glob = List("**/*.rs")
    depends = List("fmt")
    check = "cargo clippy --all-targets -- -D warnings"
  }
  // nextest runs each test in its OWN process. That isolation is worth an
  // extra tool: it makes a race between concurrently running tests much
  // harder to write in the first place.
  // SPEC.md and .spec-records are in the glob because `tests/dogfood.rs`
  // READS them. Without that, a SPEC.md-only commit skipped the entire
  // suite -- including the dogfood assertions whose whole subject is
  // SPEC.md. Four spec commits landed that way before `hk check --all`,
  // run by hand, caught a slack breach the pre-commit hook never looked
  // for. A step's glob must name every input its tests read, not just the
  // language it is written in.
  ["test"] {
    glob = List("**/*.rs", "SPEC.md", ".spec-records")
    depends = List("clippy")
    check = "cargo nextest run"
  }
  // nextest does not run doctests -- the one gap it opens, closed
  // explicitly rather than left implicit.
  ["doctest"] {
    glob = List("**/*.rs")
    depends = List("test")
    check = "cargo test --doc"
  }
  // THE DOGFOOD (V24). microlith formats its own law, using the binary being
  // built -- so a rule this crate cannot pass is a rule it cannot ship.
  // Triggered by the spec itself as well as the code, so a docs-only
  // commit is still gated.
  ["microlith"] {
    glob = List("SPEC.md", ".spec-records", "**/*.rs")
    depends = List("doctest")
    check = "cargo run -q --bin mth -- fmt --check SPEC.md || { echo 'hk: SPEC.md is not formatted. Run `mth fmt SPEC.md`. If a line is over the cap, split the statement -- raising the cap is a reviewed decision. See AGENTS.md' >&2; exit 1; }"
  }
  // The other half of the dogfood: the STRUCTURAL rules, run on our own law
  // with our own records. `fmt` says the file is shaped right; this says it
  // is still correct -- sections in order, ids unique, citations resolving,
  // and the rejected-option records still present.
  ["microlith-check"] {
    glob = List("SPEC.md", ".spec-records", "**/*.rs")
    depends = List("microlith")
    check = "cargo run -q --bin mth -- check --records .spec-records SPEC.md || { echo 'hk: SPEC.md failed its own structural rules. Each line above names the invariant it broke. See AGENTS.md' >&2; exit 1; }"
  }
  // Hygiene, all of it `hk util` -- native to the runner, so it needs no
  // extra binary in the shell or on a CI runner. These are also the first
  // steps that genuinely run in parallel rather than queueing behind the
  // target-dir lock.
  //
  // `pkl/` is excluded from every fixer: it is upstream's schema, vendored
  // VERBATIM, and reformatting it would silently fork it.
  ["trailing-whitespace"] {
    glob = List("**/*")
    exclude = List("pkl/**")
    check_diff = "hk util trailing-whitespace --diff {{files}}"
    fix = "hk util trailing-whitespace --fix {{files}}"
  }
  ["final-newline"] {
    glob = List("**/*")
    exclude = List("pkl/**")
    check_diff = "hk util end-of-file-fixer --diff {{files}}"
    fix = "hk util end-of-file-fixer --fix {{files}}"
  }
  ["line-endings"] {
    glob = List("**/*")
    exclude = List("pkl/**")
    check_diff = "hk util mixed-line-ending --diff {{files}}"
    fix = "hk util mixed-line-ending --fix {{files}}"
  }
  // The one text fixer here aimed at HOW this repo is written rather than at
  // a generic hygiene rule. Every document in it is LLM-authored, and a
  // model emits U+2018/2019/201C/201D where a keyboard emits `" '` -- so the
  // artifact that gives away generated prose is also the one nothing was
  // watching.
  //
  // Those codepoints are NAMED rather than shown, because writing them as
  // examples is what this step rejects -- which it did, to this comment, on
  // its first run. A rule that catches its own documentation is working.
  //
  // It is not only cosmetic. A smart quote inside a fenced command is a
  // command that does not run when a reader copies it, and `docs/` is full
  // of commands meant to be copied.
  //
  // MEASURED before landing: zero in our own files, one hit in
  // `pkl/Config.pkl` -- which is upstream's, excluded here for the same
  // reason it is excluded from every other fixer, and is precisely the file
  // that shows this can find something.
  ["smart-quotes"] {
    glob = List("**/*")
    exclude = List("pkl/**")
    check_diff = "hk util fix-smart-quotes --diff {{files}}"
    fix = "hk util fix-smart-quotes {{files}}"
  }
  ["no-bom"] {
    glob = List("**/*")
    check = "hk util check-byte-order-marker {{files}}"
  }
  ["no-merge-conflict"] {
    glob = List("**/*")
    check = "hk util check-merge-conflict --assume-in-merge {{files}}"
  }
  // OFFLINE half of cargo-deny (see deny.toml). `bans` is the one that
  // earns its place today: an allowlist naming only this crate turns the
  // zero-dependency claim -- made in README, Cargo.toml and AGENTS.md, and
  // enforced nowhere -- into a runner. MEASURED: a planted `cfg-if` is
  // rejected by name, with the chain that pulled it in.
  //
  // `advisories` is NOT here: it fetches the RustSec database, and this set
  // runs on every commit. It lives in the slow set instead.
  ["deny"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    // Absence before findings, as with ripsecrets: `no such command: deny`
    // is also a non-zero exit, and reporting it as a rejected dependency
    // tree names the wrong cause entirely (B8).
    check = """
      cargo deny --version >/dev/null 2>&1 || { echo 'hk: cargo-deny is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }
      cargo deny check bans licenses sources || { echo 'hk: cargo-deny rejected the dependency tree. A NEW DEPENDENCY is a decision, not a detail -- this crate ships zero, and that is what makes its supply chain claims true. See deny.toml.' >&2; exit 1; }
      """
  }
  // INTEGRATION.md DESCRIBES THE GATE, so it rots every time the gate grows.
  // MEASURED at the moment this landed: the doc said 19 fast / 21 all while
  // the real numbers were 25 and 29, and it did not mention `deny`,
  // `deny-advisories`, `ripsecrets`, `semver` or `smart-quotes` at all. Five
  // steps were added in one session and the document explaining them said
  // they did not exist -- for a repo whose entire argument is that a claim
  // needs a runner, that is the defect on the letterhead.
  //
  // WHAT IS CHECKED is only the arithmetic, deliberately. Every `N steps` in
  // the doc must equal the fast or the all count, and both must appear, so a
  // doc that quietly dropped its numbers cannot pass by saying nothing. The
  // PROSE is not checked and could not be: whether a paragraph still
  // describes what a step does is a judgement, and V6 keeps judgement out of
  // mechanical checks. This catches the half that is countable.
  ["integration-doc"] {
    glob = List("hk.pkl", "docs/INTEGRATION.md")
    check = """
      fast=$(awk '/^local fast/,/^}/' hk.pkl | grep -cE '^  [[]["]')
      extra=$(awk '/^local all/,/^}/' hk.pkl | grep -cE '^  [[]["]')
      pcx=$(awk '/^local precommit/,/^}/' hk.pkl | grep -cE '^  [[]["]')
      all=$((fast + extra))
      pc=$((fast + pcx))
      stated=$(grep -oE '[0-9]+ steps?' docs/INTEGRATION.md | grep -oE '^[0-9]+' | sort -u)
      [ -n "$stated" ] || { echo "hk: docs/INTEGRATION.md states no step count at all. It is the document that explains the gate; a count that vanished is not the same as a count that is right." >&2; exit 1; }
      bad=$(echo "$stated" | grep -vE "^($fast|$pc|$all)$" || true)
      [ -z "$bad" ] || { echo "hk: docs/INTEGRATION.md claims $(echo $bad)steps; hk.pkl defines $fast fast, $pc pre-commit and $all all. The doc describes the gate, so it goes stale every time the gate grows -- fix the numbers, and check whether the new steps are described at all." >&2; exit 1; }
      echo "$stated" | grep -qx "$all" || { echo "hk: docs/INTEGRATION.md never states the all-set count ($all). Stating only the commit-side number hides drift in the half that gates a push." >&2; exit 1; }
      echo "$stated" | grep -qxE "$fast|$pc" || { echo "hk: docs/INTEGRATION.md never states the commit-side count ($fast fast, or $pc with the pre-commit-only guard). Stating only the all count hides drift in the half you meet on every commit." >&2; exit 1; }
      """
  }
  // WHAT THE TARBALL SHIPS, checked rather than described. Publishing does
  // not upload the repo: it uploads a `.crate` whose file set is DERIVED --
  // git-tracked, minus `exclude`. That is a SECOND file set, and until now
  // nothing here examined it. The claim about it lived in a Cargo.toml
  // comment, which is a rule with no runner (V17).
  //
  // The failure it catches is invisible locally BY CONSTRUCTION. Drop
  // `.spec-records` from the package and the repo's own suite stays green --
  // the repo still has the file. MEASURED on the real tarball: 184 of 184
  // pass unpacked; delete that one file and `cli::tests::check_says_what_it_
  // examined` panics at src/cli.rs:642. The first person to see it would be
  // a consumer, and crates.io is IMMUTABLE, so it costs a version number.
  //
  // LIST ONLY, deliberately. `cargo package` also VERIFY-BUILDS the unpacked
  // tarball, which catches more -- a dropped module, an unresolvable path
  // dep -- but from a COLD target dir, on every commit. `--list` is metadata:
  // 21ms. It does not run the tarball's tests either way, so the wider net is
  // `cargo package` + unpack + `cargo test`, which is T8's job ONCE at
  // release, not this hook's job every commit.
  //
  // The required paths are read from `package.metadata.microlith`, ⊥ listed
  // here: this step and the `exclude` it guards are two halves of ONE
  // decision, and a second copy is the defect this crate exists to prevent
  // (V7). Glob is `**/*` for the same reason as `links` -- DELETING a
  // required file must trip this, and a deleted file is not in `{{files}}`.
  //
  // No backticks in the failure message: it is inside a DOUBLE-quoted echo,
  // so it interpolates `$missing` -- and a backtick there is command
  // substitution. The first draft ran `must-package` as a command and
  // dropped both words from the text it was trying to print. This comment
  // lives OUT here for the same class of reason: `//` inside the script
  // block is a PATH, not a comment, and cost one gate run at exit 126.
  //
  // NO BACKSLASHES IN ANY SCRIPT HERE. Pkl passes `\\` through to the shell
  // as two characters, so `grep -E '\\["'` matches a literal backslash and
  // finds NOTHING -- a pattern that silently counts 0 rather than erroring.
  // Where a bracket must be matched, `[[]` does it with no escape at all,
  // and `echo "$var"` replaces `printf '%s\\n'`.
  ["package"] {
    glob = List("**/*")
    check = """
      mkdir -p target
      list=$(cargo package --list --allow-dirty 2>/dev/null) || { echo 'hk: `cargo package --list` failed -- the manifest cannot produce a tarball at all. Fix Cargo.toml before worrying about its contents.' >&2; exit 1; }
      missing=""
      for p in $(taplo get -f Cargo.toml 'package.metadata.microlith.must-package[*]'); do
        echo "$list" | grep -qxF "$p" || missing="$missing $p"
      done
      [ -z "$missing" ] || { echo "hk: the published .crate would ship WITHOUT:$missing -- and the repo's own tests would stay GREEN, because the repo still has them. Either fix the exclude list in Cargo.toml, or drop the path from must-package and say why it is no longer needed." >&2; exit 1; }
      echo "$list" | sort > target/crate-files.txt
      diff -q .crate-files target/crate-files.txt >/dev/null || { echo 'hk: what the .crate SHIPS changed. The lines below are the difference between the recorded file set and the one this tree would publish. If it is intended, run `hk fix` to record it -- the point is that it lands in a DIFF a reviewer reads, rather than being discovered at publish time. If it is not, something was added, deleted or excluded by accident.' >&2; diff .crate-files target/crate-files.txt >&2; exit 1; }
      """
    // The RECORDED file set, frozen against the measurement -- the same shape
    // as `.coverage` and the README badges (V33). must-package above asserts
    // that named paths are PRESENT; this asserts that the set did not MOVE,
    // which is the other half and the one no gate looked at.
    //
    // Recorded in a FILE rather than diffed against the last release tag: a
    // tag comparison needs a worktree and a second `cargo package` on every
    // run, and it can only speak at release time. A committed list turns the
    // same fact into a line in the pull request that CAUSED it -- read by a
    // reviewer, months before anyone publishes.
    //
    // `.crate-files` is itself excluded from the package, so the list never
    // has to describe itself.
    //
    // TWO ENTRIES ARE NOT IN GIT, and looking for them in the tree is a wasted
    // search: `cargo package --list` names what the TARBALL holds, and cargo
    // synthesizes `Cargo.toml.orig` (the manifest verbatim, since the shipped
    // `Cargo.toml` is cargo's normalized rewrite) and `.cargo_vcs_info.json`
    // (the commit the crate was built from -- the very record T8's
    // publish-from-main rule exists to keep resolvable). Names only, so both
    // stay stable across commits.
    fix = """
      cargo package --list --allow-dirty 2>/dev/null | sort > .crate-files || { echo 'hk: `cargo package --list` failed, so the .crate file set could not be recorded.' >&2; exit 1; }
      """
  }
  // A leaked token in git history is IRREVERSIBLE -- the same property that
  // made removing one string from this repo's history a two-pass rewrite.
  // Before a repo goes public is the last moment that is cheap.
  //
  // Runs beside `no-private-key`, not instead of it: that step catches PEM
  // blocks, this catches the token shapes it does not.
  ["ripsecrets"] {
    glob = List("**/*")
    exclude = List("pkl/**")
    // `||` alone would report a LEAK when the tool is merely missing --
    // "command not found" is also a non-zero exit. A check that names the
    // wrong cause is worse than one that misses (B8), so absence is
    // distinguished from a finding before either is announced.
    check = """
      command -v ripsecrets >/dev/null 2>&1 || { echo 'hk: ripsecrets is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }
      ripsecrets {{files}} || { echo 'hk: a possible secret is staged. If it is real it must never be committed -- a token in git history outlives its deletion. If it is a false positive, add it to .secretsignore.' >&2; exit 1; }
      """
  }
  // Irreversible if it ever fires late -- a key in git history stays in
  // git history.
  ["no-private-key"] {
    glob = List("**/*")
    check = "hk util detect-private-key {{files}}"
  }
  ["no-large-files"] {
    glob = List("**/*")
    check = "hk util check-added-large-files {{files}}"
  }
  ["no-case-conflict"] {
    glob = List("**/*")
    check = "hk util check-case-conflict {{files}}"
  }
  ["no-broken-symlinks"] {
    glob = List("**/*")
    check = "hk util check-symlinks {{files}}"
  }
  // Steps below need a real binary, unlike the `hk util` family. Pinned in
  // the dev shell so local and CI run the same versions.
  //
  // NOT PRESENT, and that is deliberate rather than forgotten:
  //   * shellcheck -- there are no shell scripts here yet. A linter with
  //     nothing to lint is the same shape as a rule with no runner.
  //
  // `ci.yml` is the one file no other step here exercises -- it runs on
  // GitHub, not locally -- so without this a mistake in it is found only by
  // pushing. Landed with the workflow that really runs, not before.
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "actionlint {{files}}"
  }
  ["typos"] {
    glob = List("**/*")
    // `pkl/` is upstream's schema, vendored VERBATIM. It carries a
    // misspelling of "precedence" in a doc comment (Config.pkl:201) and
    // that misspelling STAYS: correcting it forks the vendored bytes, so
    // the next re-sync becomes a conflict instead of a copy. Exempting the
    // vendored tree is the whole point of vendoring it.
    //
    // The misspelled word is NOT quoted above, deliberately: typos scans
    // this file too, so naming the defect literally reintroduces it -- the
    // exemption would then be needed for the comment explaining the
    // exemption. Learned by doing exactly that.
    exclude = List("pkl/**")
    // --force-exclude: config excludes are ignored for paths passed
    // explicitly, and hk always passes them explicitly.
    check = "typos --force-exclude {{files}}"
    fix = "typos --force-exclude --write-changes {{files}}"
  }
  // OFFLINE ONLY. `--offline` checks relative paths and skips every http
  // link, which is the half that breaks when a file moves and the half no
  // other step can see. External URLs are deliberately NOT checked here:
  // they need the network the rest of this gate refuses to use, and a 404
  // on someone else's site is not a reason to reject your commit.
  // CHECKS EVERY DOCUMENT, deliberately ignoring {{files}}. A link breaks
  // when its TARGET moves, and the target's referrer is usually NOT in the
  // changed set -- rename docs/CONTRIBUTING.md and README still points at
  // the old path while never appearing staged. Scoping this step to changed
  // files makes it pass on exactly the commit that breaks the link.
  // MEASURED: with the staged-file scope it saw 1 file and reported clean
  // on a rename that had just broken a README link.
  //
  // The glob is `**/*` for the same reason: README links to Cargo.toml,
  // flake.nix, hk.pkl and LICENSE, so a link can break with no markdown
  // touched at all. Costs nothing -- the whole run is sub-second.
  //
  // Fixtures are INPUTS to tests, not prose: their content is the thing
  // under test, and one may yet need a malformed link to exercise a rule.
  // Same argument that keeps `pkl/` out of every fixer here.
  ["links"] {
    glob = List("**/*")
    check = "lychee --offline --no-progress --exclude-path tests/constructs . || { echo 'hk: a relative link does not resolve. Fix the path, or the file it points at.' >&2; exit 1; }"
  }
  ["taplo"] {
    glob = List("**/*.toml")
    exclude = List("pkl/**")
    check = "taplo format --check --diff {{files}}"
    fix = "taplo format {{files}}"
  }
  // The flake decides what every other step runs with, so drift there is
  // drift everywhere. CHECK mode only: this file is hand-commented, and a
  // formatter that rewrites on commit would fight the comments.
  // README's badge block is GENERATED, like the `mth docs` block above it.
  // Eleven numbers -- edition, MSRV, dependency count, coverage floor,
  // coverage, and one badge per OS the flake builds -- each read from the
  // file that owns it. Hand-maintaining them is eleven chances to be wrong,
  // and the coverage one already went stale once within hours.
  //
  // CHEAP ON PURPOSE, so it can live in `fast` and run on every commit: the
  // expensive input (coverage) is read from `.coverage`, which the `coverage`
  // step writes. `depends` orders the two when both are in the set, and is
  // ignored in `fast` where coverage is absent -- so pre-commit regenerates
  // from the cache and pre-push checks against a fresh measurement.
  ["readme-badges"] {
    glob = List("README.md", ".coverage", "Cargo.toml", "flake.nix", "flake.lock", "hk.pkl")
    depends = List("coverage")
    check = """
      mkdir -p target
      ed=$(sed -n 's/^edition = "\(.*\)"/\1/p' Cargo.toml)
      msrv=$(sed -n 's/^rust-version = "\(.*\)"/\1/p' Cargo.toml)
      deps=$(awk '/^\[dependencies\]/{f=1;next} /^\[/{f=0} f&&NF' Cargo.toml | wc -l | tr -d ' ')
      floor=$(grep -oE 'fail-under-lines [0-9]+' hk.pkl | head -1 | grep -oE '[0-9]+')
      cov=$(awk '/^lines /{print $2}' .coverage)
      # READ, not written down. This badge said `26.11` for as long as it
      # existed and became a lie the moment the flake started following
      # nixpkgs-lock -- a hand-kept number inside the very step that exists
      # to stop hand-kept numbers. The channel lives in flake.lock's `ref`,
      # which is the file that owns it, so read it from there.
      chan=$(grep -oE '"ref": "nixos-[0-9]+\.[0-9]+"' flake.lock | head -1 | grep -oE '[0-9]+\.[0-9]+')
      [ -n "$chan" ] || { echo 'hk: flake.lock names no `nixos-XX.YY` ref -- the nixpkgs badge has nothing to read. If the fleet stopped following a release channel, the badge must say what it follows NOW rather than keep a stale number.' >&2; exit 1; }
      R=https://img.shields.io/badge
      plat=$(sed -n '/systems = \[/,/\];/p' flake.nix | grep -oE '"[a-z0-9_-]+"' | tr -d '"' \
        | while read t; do
            o=${t##*-}; [ "$o" = darwin ] && o=macos
            case ${t%-*} in
              x86_64)  echo "1 intel $o"; echo "2 amd $o" ;;
              aarch64) echo "3 arm $o" ;;
              *)       echo "9 ${t%-*} $o" ;;
            esac
          done | sort \
        | while read r v o; do
            echo "[![$v $o](https://img.shields.io/badge/$o-5277C3?logo=$v&logoColor=white)](flake.nix)"
          done)
      { cat <<EOF
      [![CI](https://github.com/pr0d1r2/microlith/actions/workflows/ci.yml/badge.svg)](https://github.com/pr0d1r2/microlith/actions/workflows/ci.yml)
      [![License: MIT]($R/license-MIT-blue.svg)](LICENSE)
      [![crates.io](https://img.shields.io/crates/v/microlith.svg)](https://crates.io/crates/microlith)
      [![docs.rs](https://docs.rs/microlith/badge.svg)](https://docs.rs/microlith)
      [![edition $ed]($R/edition-$ed-000000?logo=rust&logoColor=white)](Cargo.toml)
      [![MSRV $msrv]($R/MSRV-$msrv-000000?logo=rust&logoColor=white)](Cargo.toml)
      [![dependencies $deps]($R/dependencies-$deps-brightgreen)](Cargo.toml)
      [![unsafe forbidden]($R/unsafe-forbidden-brightgreen)](Cargo.toml)
      [![gate hk]($R/gate-hk-6E4AFF)](hk.pkl)
      [![coverage $cov%]($R/coverage-$cov%25-brightgreen)](hk.pkl)
      [![floor $floor%]($R/floor-%E2%89%A5$floor%25-brightgreen)](hk.pkl)

      [![nix flake]($R/nix-flake-5277C3?logo=nixos&logoColor=white)](flake.nix)
      [![nixpkgs $chan]($R/nixpkgs-$chan-5277C3?logo=nixos&logoColor=white)](flake.lock)
      $plat

      [![built with Claude Code]($R/built_with-Claude_Code-D97757)](https://claude.com/claude-code)
      [![built with Opus 5]($R/built_with-Opus_5-D97757)](https://www.anthropic.com/claude)
      [![built with SDD]($R/built_with-spec--driven_development-D97757)](SPEC.md)
      EOF
      } | sed 's/^      //' > target/badges.txt
      awk '/^<!-- BEGIN badges -->$/{f=1;next} /^<!-- END badges -->$/{f=0} f' README.md > target/badges-current.txt
      diff -q target/badges-current.txt target/badges.txt >/dev/null || { echo 'hk: README badge block is stale. Run `hk fix` to regenerate it from Cargo.toml, flake.nix, hk.pkl and .coverage.' >&2; diff target/badges-current.txt target/badges.txt >&2; exit 1; }
      """
    fix = """
      mkdir -p target
      ed=$(sed -n 's/^edition = "\(.*\)"/\1/p' Cargo.toml)
      msrv=$(sed -n 's/^rust-version = "\(.*\)"/\1/p' Cargo.toml)
      deps=$(awk '/^\[dependencies\]/{f=1;next} /^\[/{f=0} f&&NF' Cargo.toml | wc -l | tr -d ' ')
      floor=$(grep -oE 'fail-under-lines [0-9]+' hk.pkl | head -1 | grep -oE '[0-9]+')
      cov=$(awk '/^lines /{print $2}' .coverage)
      # READ, not written down. This badge said `26.11` for as long as it
      # existed and became a lie the moment the flake started following
      # nixpkgs-lock -- a hand-kept number inside the very step that exists
      # to stop hand-kept numbers. The channel lives in flake.lock's `ref`,
      # which is the file that owns it, so read it from there.
      chan=$(grep -oE '"ref": "nixos-[0-9]+\.[0-9]+"' flake.lock | head -1 | grep -oE '[0-9]+\.[0-9]+')
      [ -n "$chan" ] || { echo 'hk: flake.lock names no `nixos-XX.YY` ref -- the nixpkgs badge has nothing to read. If the fleet stopped following a release channel, the badge must say what it follows NOW rather than keep a stale number.' >&2; exit 1; }
      R=https://img.shields.io/badge
      plat=$(sed -n '/systems = \[/,/\];/p' flake.nix | grep -oE '"[a-z0-9_-]+"' | tr -d '"' \
        | while read t; do
            o=${t##*-}; [ "$o" = darwin ] && o=macos
            case ${t%-*} in
              x86_64)  echo "1 intel $o"; echo "2 amd $o" ;;
              aarch64) echo "3 arm $o" ;;
              *)       echo "9 ${t%-*} $o" ;;
            esac
          done | sort \
        | while read r v o; do
            echo "[![$v $o](https://img.shields.io/badge/$o-5277C3?logo=$v&logoColor=white)](flake.nix)"
          done)
      { cat <<EOF
      [![CI](https://github.com/pr0d1r2/microlith/actions/workflows/ci.yml/badge.svg)](https://github.com/pr0d1r2/microlith/actions/workflows/ci.yml)
      [![License: MIT]($R/license-MIT-blue.svg)](LICENSE)
      [![crates.io](https://img.shields.io/crates/v/microlith.svg)](https://crates.io/crates/microlith)
      [![docs.rs](https://docs.rs/microlith/badge.svg)](https://docs.rs/microlith)
      [![edition $ed]($R/edition-$ed-000000?logo=rust&logoColor=white)](Cargo.toml)
      [![MSRV $msrv]($R/MSRV-$msrv-000000?logo=rust&logoColor=white)](Cargo.toml)
      [![dependencies $deps]($R/dependencies-$deps-brightgreen)](Cargo.toml)
      [![unsafe forbidden]($R/unsafe-forbidden-brightgreen)](Cargo.toml)
      [![gate hk]($R/gate-hk-6E4AFF)](hk.pkl)
      [![coverage $cov%]($R/coverage-$cov%25-brightgreen)](hk.pkl)
      [![floor $floor%]($R/floor-%E2%89%A5$floor%25-brightgreen)](hk.pkl)

      [![nix flake]($R/nix-flake-5277C3?logo=nixos&logoColor=white)](flake.nix)
      [![nixpkgs $chan]($R/nixpkgs-$chan-5277C3?logo=nixos&logoColor=white)](flake.lock)
      $plat

      [![built with Claude Code]($R/built_with-Claude_Code-D97757)](https://claude.com/claude-code)
      [![built with Opus 5]($R/built_with-Opus_5-D97757)](https://www.anthropic.com/claude)
      [![built with SDD]($R/built_with-spec--driven_development-D97757)](SPEC.md)
      EOF
      } | sed 's/^      //' > target/badges.txt
      awk 'BEGIN{while((getline l < "target/badges.txt")>0) b=b l "\n"}
           /^<!-- BEGIN badges -->$/{print; printf "%s", b; skip=1; next}
           /^<!-- END badges -->$/{skip=0}
           !skip' README.md > target/README.new
      mv target/README.new README.md
      """
  }
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = "nixfmt --check {{files}}"
    fix = "nixfmt {{files}}"
  }
}

/// pre-push and CI add the expensive axes. Amending `fast` keeps ONE
/// definition of the cheap steps -- the slow set is the fast set plus two,
/// never a second copy that can drift.
local all = (fast) {
  // Broken intra-doc links break the docs.rs render, not the build --
  // after publish, where they cost most.
  ["rustdoc"] {
    glob = List("**/*.rs")
    depends = List("microlith")
    env { ["RUSTDOCFLAGS"] = "-D warnings" }
    check = "cargo doc --no-deps"
  }
  // 98 is one point under this crate's own MEASURED 98.83% lines
  // (format.rs 100, cli.rs 99.34, lib.rs 95.35, main.rs 0), taken from this
  // gate's own run, with doctest and rustdoc already in the chain above --
  // so the number is the one the gate produces, not one predicted for it.
  // It is NOT copied from another project: the first consumer floors at 98
  // too, and that number WOULD have failed this repo on commit one (V21).
  // It passes now because the coverage was earned, not because the number
  // was borrowed -- which is the only reason two projects may share one.
  //
  // Raised 94 -> 98 once the V32 trim and its tests landed. 94 was one
  // point under 94.68 when it was written and had drifted almost five
  // points behind, which is a ratchet that stopped ratcheting: it would
  // have accepted losing every test added since without a word.
  //
  // A floor is a RATCHET, so it sits just under current -- unlike a size
  // ceiling, which wants real headroom.
  //
  // The known gap, named rather than hidden: `main()` and the I/O error
  // arms are unreachable from lib tests. Only a process-boundary test
  // moves them, and that is its own task, not a coverage tweak.
  // Same glob as `test`, and for the same reason: this runs the same suite,
  // so it reads SPEC.md too. `clippy`, `doctest` and `rustdoc` are left at
  // `**/*.rs` because they genuinely only read Rust.
  // README.md is in the glob because this step READS it -- the badge freeze
  // below. Same rule that put SPEC.md in `test`: a step's glob names every
  // input it reads, not just the language it is written in.
  //
  // THE BADGE FREEZE. A percentage in a README is a claim with no runner
  // (V17) -- it is true the day it is written and silently wrong after.
  // Rather than reach for a third-party coverage service, which would add
  // an account, a token and a network dependency to a crate that has none,
  // the number is CHECKED against the measurement that just ran. Same shape
  // as the `mth docs` freeze on the command block (V33): render from one
  // source, then gate the copy.
  // The NETWORK half of cargo-deny: fetches the RustSec advisory database,
  // so it sits with the expensive axes rather than on every commit. Vacuous
  // while the tree is empty -- and the `deny` step above is what keeps it
  // that way, so the pair is honest rather than decorative.
  ["deny-advisories"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    depends = List("coverage")
    // Absence before findings, as with ripsecrets: `no such command: deny`
    // is also a non-zero exit, and reporting it as a rejected dependency
    // tree names the wrong cause entirely (B8).
    check = """
      cargo deny --version >/dev/null 2>&1 || { echo 'hk: cargo-deny is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }
      cargo deny check advisories || { echo 'hk: a dependency carries a security advisory or is yanked. See deny.toml.' >&2; exit 1; }
      """
  }
  // THE VERSION LADDER, MECHANICALLY. V30 says what each rung means and V34
  // splits even from odd; V32 trimmed the pub surface to the verbs the CLI
  // exposes. All three describe a PROMISE about what a version number means,
  // and until now the only thing between a breaking change and a minor bump
  // was somebody remembering to look. Same shape the zero-dependency claim
  // had before `deny`: stated in three places, enforced in none (V17).
  //
  // BASELINE IS A GIT TAG, not the crates.io index, on purpose:
  //   * offline, like everything else here bar `deny-advisories`
  //   * it works at `0.6.0-rc.1`, before the registry has anything to
  //     compare against
  //   * a tag is ours; the index requires the crate to already exist
  // The accepted cost is DRIFT -- publishing from an untagged tree makes the
  // baseline a lie, and a check green against the wrong baseline is worse
  // than none (B15). T8's release procedure tags, and that is what keeps
  // this honest.
  //
  // NO BASELINE YET, and it SAYS SO rather than passing quietly. Nothing is
  // published and no tag exists, so this has nothing to diff and reports
  // that on stderr every run. A vacuous pass announced is a different thing
  // from a vacuous pass hidden -- B15 is exactly the second one. The line
  // disappears at the first release tag, when the step arms itself.
  ["semver"] {
    glob = List("src/**/*.rs", "Cargo.toml")
    depends = List("coverage")
    check = """
      cargo semver-checks --version >/dev/null 2>&1 || { echo 'hk: cargo-semver-checks is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }
      baseline=$(git tag --list 'v*' --sort=-v:refname | head -1)
      [ -n "$baseline" ] || { echo 'hk: semver: NO BASELINE -- no release tag exists yet, so there is no prior API to diff against. This step arms itself at the first `v*` tag; it is reporting that it examined nothing, not that it found nothing.' >&2; exit 0; }
      # A baseline this toolchain CANNOT BUILD is not an API break -- and the
      # arm below calls it one. MEASURED: lowering the MSRV puts the shell's
      # rustc UNDER the last release's declared floor, cargo-semver-checks
      # fails to build the baseline's rustdoc, and the step reports that the
      # pub API broke -- a verdict about code from a run that compared none of
      # it. Same shape as NO BASELINE above: name what was NOT examined and
      # exit 0. Narrow on purpose -- it fires only when the floors are read
      # and disagree, so an ordinary baseline build failure still fails.
      base_msrv=$(git show "$baseline:Cargo.toml" 2>/dev/null | grep '^rust-version' | tr -d ' "' | cut -d= -f2)
      now=$(rustc --version | awk '{print $2}')
      if [ -n "$base_msrv" ] && [ "$(printf '%s\n%s\n' "$base_msrv" "$now" | sort -V | head -1)" != "$base_msrv" ]; then
        echo "hk: semver: BASELINE UNBUILDABLE -- $baseline declares rust-version $base_msrv and this toolchain is $now, so the baseline's rustdoc cannot be built and there is NOTHING to diff. That is the MSRV having been LOWERED, not an API break. It re-arms at the first tag whose floor this toolchain meets. Nothing was examined." >&2
        exit 0
      fi
      cargo semver-checks check-release --baseline-rev "$baseline" || { echo "hk: the pub API broke against $baseline. Either restore it, or take the version bump semver requires -- V30's ladder is a promise to consumers, and crates.io is immutable, so a wrong rung cannot be corrected." >&2; exit 1; }
      """
  }
  ["coverage"] {
    glob = List("**/*.rs", "SPEC.md", ".spec-records", "README.md")
    depends = List("rustdoc")
    check = """
      mkdir -p target
      cargo llvm-cov nextest --fail-under-lines 98 --summary-only > target/coverage.txt || { cat target/coverage.txt >&2; echo 'hk: below the coverage floor. Cover the gap; lowering the floor needs a reason in SPEC.md. See AGENTS.md' >&2; exit 1; }
      cat target/coverage.txt
      measured=$(awk '/^TOTAL/{gsub("%","",$10); print $10}' target/coverage.txt)
      cached=$(awk '/^lines /{print $2}' .coverage)
      [ "$measured" = "$cached" ] || { echo "hk: .coverage says $cached%, measured $measured%. Run \`hk run refresh\` to update the cache and the badge, then amend." >&2; exit 1; }
      """
    fix = """
      mkdir -p target
      cargo llvm-cov nextest --fail-under-lines 98 --summary-only > target/coverage.txt || { cat target/coverage.txt >&2; exit 1; }
      measured=$(awk '/^TOTAL/{gsub("%","",$10); print $10}' target/coverage.txt)
      key=$(git ls-files -s -- '*.rs' SPEC.md .spec-records | git hash-object --stdin)
      awk -v k="$key" -v m="$measured" '/^key /{print "key " k; next} /^lines /{print "lines " m; next} {print}' .coverage > target/.coverage.new
      mv target/.coverage.new .coverage
      """
  }
}

// The pre-commit set: `fast`, plus the one guard that belongs to a WORKING
// COPY rather than to a file.
//
// IT CANNOT LIVE IN `fast`. `all` is `fast` plus four, and CI runs
// `hk check --all` on `main` after every merge -- so a no-commit-to-branch
// in `fast` would fail every CI run on the branch it exists to protect.
// That is not a tuning problem, it is a category error: the rule is about
// WHERE YOU ARE COMMITTING, and CI never commits.
//
// It is the LOCAL half of a pair. GitHub refuses a push to `main` outright
// (PR required, three status checks, admins not exempt), so this changes no
// outcome -- it moves the refusal EARLIER, to before you have built a commit
// you then have to move. V23 also makes it skip outside the dev shell, which
// is exactly why the server-side rule is the one that actually defends the
// branch and this one is a courtesy (T8a).
local precommit = (fast) {
  ["no-commit-to-branch"] {
    glob = List("**/*")
    check = "hk util no-commit-to-branch --branch main"
  }
}

hooks {
  /// Fast set only: a hook you are tempted to bypass is worse than no hook.
  /// `stash = "git"` is correctness, not speed -- without it a partially
  /// staged file (`git add -p`) is checked as it looks in the worktree,
  /// giving a verdict about code you are not committing.
  ///
  /// Installed by `flake.nix`'s shellHook, BY HAND rather than by
  /// `hk install`, so a shell without hk SKIPS loudly instead of making
  /// every git command fail (V23).
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = precommit
  }
  ["pre-push"] {
    steps = all
  }
  /// What `hk check` runs -- the CI entry point. Flat and complete: CI has
  /// no fail-fast-cheapest-first gradient to optimize for.
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = fast
  }
  /// `hk run refresh` -- the FULL set in fix mode. `fix` above runs only the
  /// cheap steps, so the one expensive generator (the coverage measurement
  /// behind .coverage and the README badge) has no other way to be written.
  ["refresh"] {
    fix = true
    steps = all
  }
}
